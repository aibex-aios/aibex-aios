#!/bin/bash
# aios: install, activate and maintain AIbex AIOS (spec 04)

   if [ "$*" == "-?" ] || [ "$*" == "--help" ]; then
      echo '   usage: aios --prepare [--dev]              # prepare the machine (/opt/aios, ~/bin, stup, kit)'
      echo '          aios --install [v<version>]         # install a version (includes --prepare)'
      echo '          aios --versions                     # installed versions and their locations'
      echo '          aios --remove-version v<version>    # remove an installed version'
      echo '          aios --uninstall                    # remove forwarders, AIOS skills and hooks'
      echo '          aios --activate v<version> [<path>] # bind a vault or project to a version'
      echo '          aios --deactivate [<path>]          # remove the binding'
      echo '          aios --config [<path>]              # effective configuration and its origin'
      echo '          aios --context [<path>]             # master context of cwd or <path> (spec 02)'
      echo '          aios --context --load|--id|--list [<path>] # part files, id, listing'
      echo '          aios --context --session|--advise   # hooks (hook JSON on stdin)'
      echo '          aios --context --assistant <name> [--load] | --assistants # assistants'
      echo '          aios --context --assignment [<path>] [--session <id>] # assistant that applies'
      echo '          aios --context --sync [--yes|--plan] # register the project skills'
      echo '          aios --register [<path>]            # register the project skills (spec 03)'
      echo '          aios --init [<path>]                # make a folder a project (@/, git, .gitignore)'
      echo '          aios --integrity [<path>]           # integrity of a project and its subprojects'
      echo '          aios --assistant <name|none|inherit> # assign the assistant to the project'
      echo '                       [--to <project>] [--session <id>]'
      echo '          aios --gui [--session <id>] [--html] # surface of the assistant (--aios: of AIOS)'
      echo '                       [--apps] [--skill <surface>] # surfaces of deployed apps'
      echo '          aios --library [<word>|<package>]   # search the packages of the hub list'
      echo '          aios --hubs [add <name> [<url>] | remove <name>] [--vault] # the hub list'
      echo '          aios --fetch [<hub>/]<package>[<range>] # fetch, deploy and register a package'
      echo '                       [--hub <hub>] [--from <repo>] [--to <project>]'
      echo '          aios --fetch [--upgrade [<package>] | --remove <package>] # sync with lock.yaml'
      echo '          aios --deploy <package> --only <element>... | --all # select the elements'
      echo '          aios --deploy [--to <project>]      # show the deployed elements'
      echo '          aios --worker                       # workhorses (rebuilt in step 6, spec 07)'
      echo '          aios --run <command> [args]         # deployed command of a package'
      echo '          aios --contribute <file>... --to <package> [--message <text>] # pull request'
      echo '          aios --workspace init <repo> [<folder>] | update | freeze | status'
      echo '                       [<path>] [--group <g>] # projects of a workspace'
      echo '          aios --skill <name> [--session <id>] # body of an AIOS skill'
      echo '          aios <writing command> --plan       # show the plan only (for skills)'
      echo '          aios <writing command> --yes        # no question (after asking in the chat)'
      echo '          aios --version                      # print version'
      echo '   see also: ai-brain, stup'
      exit 1
   fi

#===============================================================================
# locations of this installation or clone
#===============================================================================

   HERE="$(cd "$(dirname "$0")/.." && pwd)"      # installation or repo root
   PY="$HERE/python/bin/python"                  # venv of an installation
   [ -x "$PY" ] || PY="python3"                  # clone: system python (stdlib only)

#===============================================================================
# print version: aios --version
#===============================================================================

   if [ "$*" == "--version" ]; then
      cat "$HERE/VERSION"; exit 0
   fi

#===============================================================================
# master context: aios --context [<option>] [<args>]  (spec 02; without loading the CLI, for the hooks)
#===============================================================================

   if [ "$1" == "--context" ]; then
      shift
      case "$1" in -*) ;; *) set -- --context "$@";; esac   # no option: print the master context
      PYTHONPATH="$HERE/lib" exec "$PY" -m aios.context "$@"
   fi

#===============================================================================
# everything else is handled by the Python part
#===============================================================================

   if [ "$1" != "" ]; then
      PYTHONPATH="$HERE/lib" exec "$PY" -m aios.cli "$@"
   fi

#===============================================================================
# cannot deal with anything else ...
#===============================================================================

   "$0" -?
   exit 1
