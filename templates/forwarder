#!/bin/bash
# forwarder: ~/.aios/bin/aios, choose the AIOS version and call it (spec 04)

   if [ "$*" == "---help" ]; then
      echo "   usage: aios <args>      # forward <args> to aios of the chosen version"
      echo "          aios ---which    # show the chosen installation and why"
      echo "          aios ---version  # print version of this forwarder"
      echo "          aios ---help     # this help"
      echo '   order: AIOS_HOME, aios --activate v<version> (that version), aios: in'
      echo '          .aios/config.yaml of the vault root, otherwise aios --context: ai-brain with'
      echo '          legacy: ai-brain there, else nothing; everything else: highest installed'
      echo '          version; aios --install distribution-*: always the highest installed'
      echo '          version, at least 0.5; aios --remove-version and aios --vaults: always the highest'
      echo '          installed version; aios --context with a version below 0.5: its aios-context;'
      echo '          aios --workspace <cmd> <path>: the binding of the vault at <path>'
      echo '   see also: aios, ai-brain'
      exit 1
   fi

#===============================================================================
# print version: aios ---version
#===============================================================================

   if [ "$*" == "---version" ]; then
      echo "0.4.2"; exit 0
   fi

#===============================================================================
# helpers: installations, versions, activation
#===============================================================================

   PREFIX="${AIOS_PREFIX:-/opt/aios}"

   installed() {                                    # print "v<version>|<path>", user wins
      local F LINE NAME VAL SEEN=""
      for F in "$HOME/.aios/installations.yaml" "$PREFIX/installations.yaml"; do
         [ -f "$F" ] || continue
         while IFS= read -r LINE || [ -n "$LINE" ]; do
            LINE="${LINE%$'\r'}"
            [[ "$LINE" =~ ^(v[0-9][^:[:space:]]*):[[:space:]]*(.*)$ ]] || continue
            NAME="${BASH_REMATCH[1]}"; VAL="${BASH_REMATCH[2]}"
            VAL="${VAL%%[[:space:]]#*}"; VAL="${VAL%"${VAL##*[![:space:]]}"}"
            VAL="${VAL#\"}"; VAL="${VAL%\"}"; VAL="${VAL#\'}"; VAL="${VAL%\'}"
            case "$VAL" in "~") VAL="$HOME";; "~/"*) VAL="$HOME/${VAL#\~/}";; esac
            case " $SEEN " in *" $NAME "*) continue;; esac
            SEEN="$SEEN $NAME"
            echo "$NAME|$VAL"
         done < "$F"
      done
   }

   lookup() {                                       # path of v<version> or nothing
      local E
      while IFS= read -r E; do
         [ "${E%%|*}" == "v$1" ] && { echo "${E#*|}"; return 0; }
      done < <(installed)
      return 1
   }

   newer() {                                        # semver: is $1 newer than $2 ?
      local A="${1#v}" B="${2#v}" AP="" BP="" I X Y
      [[ "$A" == *-* ]] && { AP="${A#*-}"; A="${A%%-*}"; }
      [[ "$B" == *-* ]] && { BP="${B#*-}"; B="${B%%-*}"; }
      IFS=. read -r -a X <<< "$A"; IFS=. read -r -a Y <<< "$B"
      for I in 0 1 2; do
         [ "$((10#${X[$I]:-0}))" -gt "$((10#${Y[$I]:-0}))" ] && return 0
         [ "$((10#${X[$I]:-0}))" -lt "$((10#${Y[$I]:-0}))" ] && return 1
      done
      [ -z "$AP" ] && [ -n "$BP" ] && return 0      # release beats pre-release
      [ -n "$AP" ] && [ -z "$BP" ] && return 1
      [[ "$AP" > "$BP" ]]
   }

   highest() {                                      # print "v<version>|<path>"
      local E BEST=""
      while IFS= read -r E; do
         { [ -z "$BEST" ] || newer "${E%%|*}" "${BEST%%|*}"; } && BEST="$E"
      done < <(installed)
      [ -n "$BEST" ] && echo "$BEST"
   }

   vault_root() {                                   # nearest dir named §* above the physical cwd
      local D; D="$(pwd -P)"
      while :; do
         case "$(basename "$D")" in §*) echo "$D"; return 0;; esac
         [ "$D" == "/" ] && return 1
         D="$(dirname "$D")"
      done
   }

   activation() {                                   # print "<version>|<config>" or nothing
      local ROOT LINE F                             # only the vault root binds (spec 04, I14)
      ROOT="$(vault_root)" || return 1              # outside a vault: never activated
      F="$ROOT/.aios/config.yaml"
      [ "$ROOT" != "$(cd "$HOME" 2>/dev/null && pwd -P)" ] && [ -f "$F" ] || return 1
      LINE="$(grep -E -m1 '^aios:' "$F")"
      if [[ "$LINE" =~ ^aios:[[:space:]]*[\"\']?v?([0-9][^\"\'[:space:]#]*) ]]; then
         echo "${BASH_REMATCH[1]}|$F"; return 0
      fi
      return 1
   }

   marked() {                                       # legacy: ai-brain at the vault root (spec 02)
      local ROOT F
      ROOT="$(vault_root)" || return 1
      F="$ROOT/.aios/config.yaml"
      [ -f "$F" ] && grep -Eq '^legacy:[[:space:]]*["'"'"']?ai-brain["'"'"']?[[:space:]]*(#.*)?$' "$F"
   }

   log() {                                          # errors outside an A/W only into the log (spec 02)
      mkdir -p "$HOME/.aios/log" 2>/dev/null && \
         echo "$(date '+%Y-%m-%dT%H:%M:%S') forwarder cwd=$(pwd -P) $*" >> "$HOME/.aios/log/context.log"
   }

   choose() {                                       # set KIND, TARGET, WHY (ARG1, ARG2: the first arguments)
      local A E
      KIND=""; TARGET=""; WHY=""
      if [ -n "$AIOS_HOME" ]; then
         KIND=aios; TARGET="$AIOS_HOME/bin/aios"; WHY="AIOS_HOME=$AIOS_HOME"; return 0
      fi
      if [ "$ARG1" == "--install" ] && [[ "$ARG2" =~ ^([A-Za-z0-9._-]+/)?distribution- ]]; then
         if E="$(highest)"; then                    # independent of cwd (V0.5, step 9)
            if newer v0.5.0 "${E%%|*}"; then
               KIND=old; TARGET="${E%%|*}"; WHY="distributions need AIOS 0.5 or later, highest installed ${E%%|*}"
               return 0
            fi
            KIND=aios; TARGET="${E#*|}/bin/aios"; WHY="aios --install distribution-*: highest installed ${E%%|*}"
            return 0
         fi
      fi
      if [ "$ARG1" == "--remove-version" ] || [ "$ARG1" == "--vaults" ]; then
         if E="$(highest)"; then                    # independent of cwd: the newest kernel knows all vaults (V0.6, B21)
            KIND=aios; TARGET="${E#*|}/bin/aios"; WHY="aios $ARG1: highest installed ${E%%|*}"; return 0
         fi
      fi
      if [ "$ARG1" == "--activate" ] && [[ "$ARG2" =~ ^v([0-9][^[:space:]]*)$ ]] \
            && E="$(lookup "${BASH_REMATCH[1]}")"; then
         KIND=aios; TARGET="$E/bin/aios"; WHY="aios --activate $ARG2"; return 0   # V0.3, memo 54 (A1)
      fi
      if A="$(activation)"; then
         WHY="aios: ${A%%|*} in ${A#*|}"
         if E="$(lookup "${A%%|*}")"; then
            KIND=aios; TARGET="$E/bin/aios"; return 0
         fi
         KIND=missing; TARGET="v${A%%|*}"; return 0
      fi
      if [ "$ARG1" == "--context" ]; then           # only the group --context calls ai-brain (V0.5, memo 03)
         if marked; then
            KIND=legacy; TARGET="$(command -v ai-brain)"; WHY="legacy: ai-brain at the vault root"
         else
            KIND=quiet; WHY="no binding: vault without aios: or outside a vault"
         fi
         return 0
      fi
      if E="$(highest)"; then
         KIND=aios; TARGET="${E#*|}/bin/aios"; WHY="not activated, highest installed ${E%%|*}"
         return 0
      fi
      KIND=none; WHY="no installation of AIOS found"
   }

   ARG1="$1"; ARG2="$2"

#===============================================================================
# aios --context [--load|--id|--list] <path>: the version follows <path>
#===============================================================================

   if [ "$1" == "--context" ]; then
      P=""
      if [ -d "$2" ] && [ "$3" == "" ]; then P="$2"
      elif [ -d "$3" ] && [ "$4" == "" ]; then
         case "$2" in --load|--id|--list) P="$3";; esac
      fi
      if [ -n "$P" ]; then
         cd "$P" || exit 1
         choose; case "$KIND" in legacy|quiet) [ "$P" == "$2" ] && set -- --context || set -- --context "$2";; esac
      fi
   fi

#===============================================================================
# show choice: aios ---which
#===============================================================================

   if [ "$*" == "---which" ]; then
      choose
      echo "tool=aios kind=$KIND target=${TARGET:--} why=$WHY"
      exit 0
   fi

#===============================================================================
# forward: aios <args>
#===============================================================================

   WSDIR=""                                         # --workspace <cmd> <path>: the binding at <path>
   if [ "$1" == "--workspace" ]; then              # (V0.6, memo 208: H37)
      SKIP=""
      for A in "${@:3}"; do
         if [ -n "$SKIP" ]; then SKIP=""; continue; fi
         case "$A" in --group|--at|--accept-deletion) SKIP=1; continue;; -*) continue;; esac
         if [ -d "$A" ]; then WSDIR="$A"; elif [ -d "$(dirname "$A")" ]; then WSDIR="$(dirname "$A")"; fi
         break
      done
   fi
   if [ -n "$WSDIR" ]; then
      OLD="$(pwd -P 2>/dev/null)"
      if cd "$WSDIR" 2>/dev/null; then
         choose; [ -n "$OLD" ] && cd "$OLD" 2>/dev/null
      else
         choose
      fi
   else
      choose
   fi
   case "$KIND" in
      aios)
         if [ "$1" == "--context" ] && [ "$2" == "--permit" ] && [ -z "$AIOS_HOME" ]; then
            V="$(cat "${TARGET%/bin/aios}/VERSION" 2>/dev/null)"           # below 0.6: no --permit,
            if [[ "$V" =~ ^0\.([0-5])\. ]] || [ -z "$V" ]; then exit 0; fi  # the host asks (V0.6, memo 47)
         fi
         [ -x "$TARGET" ] || { echo "*** aios: $TARGET not found ($WHY)" >&2; exit 1; }
         if [ "$1" == "--context" ] && [ -x "${TARGET%/aios}/aios-context" ]; then   # versions below 0.5
            V="$(cat "${TARGET%/bin/aios}/VERSION" 2>/dev/null)"                   # have aios-context
            if [ -n "$V" ] && newer v0.5.0 "v$V"; then                             # (V0.5, memo 63, B3)
               shift; exec "${TARGET%/aios}/aios-context" "$@"
            fi
         fi
         exec "$TARGET" "$@"
         ;;
      quiet)                                        # outside an A/W: nothing (spec 02, I12)
         [ "$2" == "--id" ] && echo "id=- files=0 cwd=$PWD mode=none"
         [ "$2" == "--list" ] && echo "No AIBOS workspace — no master context."
         exit 0
         ;;
      legacy)
         shift                                      # ai-brain takes the arguments after --context
         [ "$*" == "" ] && set -- --context         # aios --context = master context
         [ "$*" == "--permit" ] && exit 0           # no permission from ai-brain (spec 02)
         if [ "$*" == "--list" ]; then              # spec 02: listing of /aios-context
            echo "Legacy mode (ai-brain, legacy: ai-brain at the vault root) — see /masterspace."
            exit 0
         fi
         if [ "$*" == "--id" ]; then                # spec 02: --id names the mode
            OUT=""; [ -n "$TARGET" ] && OUT="$("$TARGET" --id 2>/dev/null)"
            case "$OUT" in
               id=*) echo "$OUT mode=legacy" ;;
               *)    echo "id=- files=0 cwd=$PWD mode=legacy" ;;
            esac
            exit 0
         fi
         [ -n "$TARGET" ] || exit 0                 # no ai-brain: no output
         exec "$TARGET" "$@"
         ;;
      old)
         echo "*** aios: $WHY" >&2
         echo "    run: aios --install v0.5.<n> (or ./bin/aios --install distribution-… in a clone)" >&2
         exit 1
         ;;
      missing)
         if [ "$1" == "--context" ]; then           # hooks: never output, only the log (spec 04)
            log "AIOS $TARGET is not installed ($WHY)"
            [ "$2" == "--id" ] && echo "id=- files=0 cwd=$PWD mode=none"
            exit 0
         fi
         echo "*** aios: AIOS $TARGET is not installed ($WHY)" >&2
         echo "    run: aios --install $TARGET" >&2
         exit 1
         ;;
   esac

#===============================================================================
# cannot deal with anything else ...
#===============================================================================

   echo "*** aios: $WHY" >&2
   echo "    run: ./bin/aios --install in a clone of aibex-aios" >&2
   exit 1
